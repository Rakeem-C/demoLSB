DATABASE_URL=
# Canonical site URL used for metadata and absolute links in production.
NEXTAUTH_URL=
# Optional base URL used for absolute booking links in outbound qualification messages.
APP_BASE_URL=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Configure this URL in Twilio Messaging webhook settings:
# https://<your-domain>/api/twilio/inbound
TWILIO_WEBHOOK_URL=

# Resend email settings
# Use a real key in .env.local (do not commit secrets)
RESEND_API_KEY=
# Example: HomeGuard Pro <onboarding@resend.dev>
RESEND_FROM_EMAIL=

# SMTP settings
# Resend SMTP relay uses smtp.resend.com with username "resend" and password = RESEND_API_KEY.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=
SMTP_FROM_EMAIL=

# Internal notifications
INTERNAL_ADMIN_PHONE=
INTERNAL_ADMIN_EMAIL=
INTERNAL_ALERTS_ENABLED=true

# Demo / provider mode
DEMO_MODE=false
USE_SIMULATED_PROVIDERS=false
